NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://email:email@localhost:5432/email_scheduler?schema=public
REDIS_URL=redis://127.0.0.1:6379
ELASTICSEARCH_URL=http://127.0.0.1:9200

SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_SECONDS=604800
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/callback

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
STALE_PROCESSING_MS=300000
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
MAX_RECIPIENTS_PER_CAMPAIGN=5000
SMTP_FROM_NAME=Postline
